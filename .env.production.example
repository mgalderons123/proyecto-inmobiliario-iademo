# Supply real values through the deployment secret manager; never commit .env.production.
DJANGO_SETTINGS_MODULE=PRY_INMOB.settings_production
DEBUG=False
SECRET_KEY=
PII_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
ALLOWED_HOSTS=casarent.app
CSRF_TRUSTED_ORIGINS=https://casarent.app
# Enable only behind a trusted HTTPS proxy which overwrites X-Forwarded-Proto.
BEHIND_HTTPS_PROXY=True
POSTGRES_DB=casarent
POSTGRES_USER=casarent
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
# Path inside the container to a mounted CA certificate, if required by the provider.
PGSSLROOTCERT=/run/certs/postgres-ca.crt
REDIS_URL=redis://redis:6379/0
PUBLIC_MEDIA_ROOT=/app/data/public
PRIVATE_MEDIA_ROOT=/app/data/private
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CasaRent <noreply@casarent.app>
