PII_ENCRYPTION_KEY=GENERATE_ME
JWT_SIGNING_KEY=GENERATE_ME

ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:4100,http://127.0.0.1:4100
RATELIMIT_ENABLE=True

